# Clé privée du compte qui déploie le contrat (commence par 0x)
# ATTENTION : ne jamais committer ce fichier avec une vraie clé
DEPLOYER_PRIVATE_KEY=0x...

# RPC URL Polygon Mainnet (ex: Alchemy, Infura, ou public)
POLYGON_RPC_URL=https://polygon-rpc.com

# RPC URL Polygon Amoy (testnet)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Adresse du contrat après déploiement (remplie après deploy)
CONTRACT_ADDRESS=0x...
