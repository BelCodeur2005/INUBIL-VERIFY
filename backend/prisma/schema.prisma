model verifications {
  id                String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  document_id       String?               @db.Uuid
  partage_id        String?               @db.Uuid
  type_verification type_verification
  resultat          resultat_verification
  hash_soumis       String?               @db.VarChar(64)
  ip_address        String?               @db.Inet
  user_agent        String?
  pays              String?               @db.VarChar(100)
  ville             String?               @db.VarChar(100)
  organisation      String?               @db.VarChar(255)
  utilisateur_id    String?               @db.Uuid
  rapport_genere    Boolean               @default(false)
  rapport_pdf_url   String?               @db.VarChar(500)
  created_at        DateTime              @default(now()) @db.Timestamptz(6)
  documents         documents?            @relation(fields: [document_id], references: [id], onUpdate: NoAction)
  partages_document partages_document?    @relation(fields: [partage_id], references: [id], onUpdate: NoAction)
  utilisateurs      utilisateurs?         @relation(fields: [utilisateur_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_verifications_created_at")
  @@index([document_id], map: "idx_verifications_document_id")
  @@index([ip_address], map: "idx_verifications_ip")
  @@index([partage_id], map: "idx_verifications_partage_id")
  @@index([resultat], map: "idx_verifications_resultat")
}

model webhook_livraisons {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  webhook_id  String   @db.Uuid
  evenement   String   @db.VarChar(100)
  payload     Json
  statut_http Int?
  reponse     String?
  duree_ms    Int?
  succes      Boolean  @default(false)
  tentative   Int      @default(1)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  webhooks    webhooks @relation(fields: [webhook_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_webhook_livraisons_date")
  @@index([webhook_id], map: "idx_webhook_livraisons_wid")
}

model webhooks {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universite_id      String               @db.Uuid
  nom                String               @db.VarChar(100)
  url                String               @db.VarChar(500)
  secret             String               @db.VarChar(255)
  evenements         Json                 @default("[]")
  statut             statut_webhook       @default(actif)
  nb_succes          Int                  @default(0)
  nb_echecs          Int                  @default(0)
  derniere_livraison DateTime?            @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  created_by         String?              @db.Uuid
  webhook_livraisons webhook_livraisons[]
  utilisateurs       utilisateurs?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  universites        universites          @relation(fields: [universite_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([universite_id], map: "idx_webhooks_universite_id")
}

