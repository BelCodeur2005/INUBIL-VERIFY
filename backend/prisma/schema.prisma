  email                                               String?             @db.VarChar(255)
  telephone                                           String?             @db.VarChar(50)
  photo_url                                           String?             @db.VarChar(500)
  universite_id                                       String              @db.Uuid
  annee_entree                                        Int?
  metadata                                            Json                @default("{}")
  deleted_at                                          DateTime?           @db.Timestamptz(6)
  created_at                                          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                          DateTime            @default(now()) @db.Timestamptz(6)
  created_by                                          String?             @db.Uuid
  documents                                           documents[]
  utilisateurs_etudiants_created_byToutilisateurs     utilisateurs?       @relation("etudiants_created_byToutilisateurs", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  universites                                         universites         @relation(fields: [universite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  utilisateurs_etudiants_utilisateur_idToutilisateurs utilisateurs?       @relation("etudiants_utilisateur_idToutilisateurs", fields: [utilisateur_id], references: [id], onUpdate: NoAction)
  invitations                                         invitations[]
  partages_document                                   partages_document[]

  @@index([email], map: "idx_etudiants_email")
  @@index([numero_etudiant], map: "idx_etudiants_numero")
  @@index([universite_id], map: "idx_etudiants_universite_id")
}

