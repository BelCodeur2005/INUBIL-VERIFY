generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cles_api {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universite_id        String        @db.Uuid
  nom                  String        @db.VarChar(100)
  cle_hachee           String        @unique @db.VarChar(255)
  prefix               String        @db.VarChar(12)
  permissions          Json          @default("[]")
  derniere_utilisation DateTime?     @db.Timestamptz(6)
  nb_utilisations      BigInt        @default(0)
  expiration           DateTime?     @db.Timestamptz(6)
  est_active           Boolean       @default(true)
  ip_whitelist         Json          @default("[]")
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime      @default(now()) @db.Timestamptz(6)
  created_by           String?       @db.Uuid
  utilisateurs         utilisateurs? @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  universites          universites   @relation(fields: [universite_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([prefix], map: "idx_cles_api_prefix")
  @@index([universite_id], map: "idx_cles_api_universite_id")
}

model configurations {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cle            String        @unique @db.VarChar(100)
  valeur         String
  type           String        @default("string") @db.VarChar(20)
  description    String?
  modifiable_par String        @default("super_admin") @db.VarChar(20)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_by     String?       @db.Uuid
  utilisateurs   utilisateurs? @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documents {
  id                                               String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  numero_unique                                    String                    @unique @db.VarChar(20)
  url_verification                                 String?                   @default(dbgenerated("('https://verify.inubil.com/d/'::text || (numero_unique)::text)")) @db.VarChar(500)
  etudiant_id                                      String                    @db.Uuid
  universite_id                                    String                    @db.Uuid
  type_document_id                                 String                    @db.Uuid
  annee_academique                                 String?                   @db.VarChar(9)
  date_emission                                    DateTime                  @db.Date
  date_validite                                    DateTime?                 @db.Date
  lieu_delivrance                                  String?                   @db.VarChar(150)
  filiere                                          String?                   @db.VarChar(255)
  donnees                                          Json                      @default("{}")
  mention_id                                       String?                   @db.Uuid
  note_sur                                         Decimal                   @default(20) @db.Decimal(5, 2)
  moyenne_generale                                 Decimal?                  @db.Decimal(5, 2)
  pdf_url                                          String?                   @db.VarChar(500)
  pdf_taille_ko                                    Int?
  pdf_chiffre                                      Boolean                   @default(false)
  chiffrement_iv                                   String?                   @db.VarChar(32)
  chiffrement_cle_wrappee                          String?
  hash_sha256                                      String?                   @unique @db.VarChar(64)
  adresse_contrat                                  String?                   @db.VarChar(42)
  transaction_hash                                 String?                   @db.VarChar(66)
  bloc_numero                                      BigInt?
  reseau                                           reseau_blockchain?
  qr_code_url                                      String?                   @db.VarChar(500)
  statut                                           statut_document           @default(brouillon)
  saisi_par                                        String?                   @db.Uuid
  valide_par                                       String?                   @db.Uuid
  valide_le                                        DateTime?                 @db.Timestamptz(6)
  emis_le                                          DateTime?                 @db.Timestamptz(6)
  revoque_par                                      String?                   @db.Uuid
  raison_revocation                                String?
  revoque_le                                       DateTime?                 @db.Timestamptz(6)
  motif_rejet                                      String?
  rejete_par                                       String?                   @db.Uuid
  rejete_le                                        DateTime?                 @db.Timestamptz(6)
  metadata                                         Json                      @default("{}")
  deleted_at                                       DateTime?                 @db.Timestamptz(6)
  created_at                                       DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime                  @default(now()) @db.Timestamptz(6)
  etudiants                                        etudiants                 @relation(fields: [etudiant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mentions_document                                mentions_document?        @relation(fields: [mention_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  utilisateurs_documents_revoque_parToutilisateurs utilisateurs?             @relation("documents_revoque_parToutilisateurs", fields: [revoque_par], references: [id], onUpdate: NoAction)
  utilisateurs_documents_rejete_parToutilisateurs  utilisateurs?             @relation("documents_rejete_parToutilisateurs", fields: [rejete_par], references: [id], onUpdate: NoAction)
  utilisateurs_documents_saisi_parToutilisateurs   utilisateurs?             @relation("documents_saisi_parToutilisateurs", fields: [saisi_par], references: [id], onUpdate: NoAction)
  types_document                                   types_document            @relation(fields: [type_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  universites                                      universites               @relation(fields: [universite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  utilisateurs_documents_valide_parToutilisateurs  utilisateurs?             @relation("documents_valide_parToutilisateurs", fields: [valide_par], references: [id], onUpdate: NoAction)
  invitations                                      invitations[]
  matieres_document                                matieres_document[]
  partages_document                                partages_document[]
  transactions_blockchain                          transactions_blockchain[]
  verifications                                    verifications[]

  @@index([date_emission], map: "idx_documents_date_emission")
  @@index([donnees], map: "idx_documents_donnees", type: Gin)
  @@index([etudiant_id], map: "idx_documents_etudiant_id")
  @@index([hash_sha256], map: "idx_documents_hash_sha256")
  @@index([numero_unique], map: "idx_documents_numero_unique")
  @@index([statut], map: "idx_documents_statut")
  @@index([transaction_hash], map: "idx_documents_transaction_hash")
  @@index([type_document_id], map: "idx_documents_type_id")
  @@index([universite_id], map: "idx_documents_universite_id")
}

model emails_log {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  utilisateur_id String?       @db.Uuid
  destinataire   String        @db.VarChar(255)
  sujet          String        @db.VarChar(255)
  template       String        @db.VarChar(100)
  parametres     Json          @default("{}")
  statut         statut_email  @default(en_attente)
  tentatives     Int           @default(0)
  max_tentatives Int           @default(3)
  erreur         String?
  message_id     String?       @db.VarChar(255)
  envoye_le      DateTime?     @db.Timestamptz(6)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  utilisateurs   utilisateurs? @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_emails_created_at")
  @@index([destinataire], map: "idx_emails_destinataire")
  @@index([statut], map: "idx_emails_statut")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model etudiants {
  id                                                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  utilisateur_id                                      String?             @unique @db.Uuid
  numero_etudiant                                     String              @unique @db.VarChar(50)
