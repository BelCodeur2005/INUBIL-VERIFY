# ================================
# INUBIL Verify — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS COMMITER le fichier .env
# ================================

# ─── PostgreSQL (Docker) ───────────────────────────────────────────────────────
POSTGRES_USER=inubil
POSTGRES_PASSWORD=changer_ce_mot_de_passe
POSTGRES_DB=inubil_db
DATABASE_URL=postgresql://inubil:changer_ce_mot_de_passe@postgres:5432/inubil_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Access token court (15m) : expo reduite en cas de vol. Refresh = longevite.
JWT_SECRET=changer_cette_valeur_secrete_min_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changer_cette_valeur_refresh_min_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Nodemailer) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre_email@gmail.com
MAIL_PASS=votre_mot_de_passe_application_gmail
MAIL_FROM=INUBIL Verify <noreply@inubil.com>

# ─── IPFS — Pinata ────────────────────────────────────────────────────────────
PINATA_API_KEY=votre_cle_api_pinata
PINATA_SECRET_KEY=votre_cle_secrete_pinata
PINATA_GATEWAY=https://gateway.pinata.cloud

# ─── Blockchain — Polygon ─────────────────────────────────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=votre_cle_privee_wallet_sans_0x
CONTRACT_ADDRESS=adresse_du_contrat_apres_deploiement

# ─── Chiffrement des PDF (avant upload IPFS — cahier §9.2) ──────────────────────
# Cle maitre AES-256 (64 caracteres hex). Chiffre les cles de donnees stockees en base.
# NE JAMAIS commiter la vraie valeur. Generer avec : openssl rand -hex 32
ENCRYPTION_MASTER_KEY=changer_cle_maitre_64_caracteres_hex

# ─── Securite ───────────────────────────────────────────────────────────────────
# Cout bcrypt (minimum 12 exige par le cahier §9.1)
BCRYPT_SALT_ROUNDS=12
# Fenetre d'inactivite (minutes) : une session sans refresh au-dela expire.
SESSION_IDLE_MINUTES=30

# ─── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@inubil.com
PGADMIN_PASSWORD=admin

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
FRONTEND_URL=http://localhost:4200

# Base du lien unique universel : {PUBLIC_VERIFY_URL}/d/{numero_unique}
# En production : https://verify.inubil.com
PUBLIC_VERIFY_URL=http://localhost:4200
