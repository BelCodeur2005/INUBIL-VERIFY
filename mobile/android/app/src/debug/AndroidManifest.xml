<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Autorise le trafic HTTP en clair (localhost, IP locale de dev) —
         uniquement en debug : Android bloque le HTTP par defaut depuis l'API 28.
         Ne s'applique pas aux builds release/profile, qui doivent pointer vers
         un backend HTTPS (voir ApiConfig.baseUrl / --dart-define API_BASE_URL). -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
